# SvelteKit
BASE_URL=
PUBLIC_BASE_URL="http://localhost:5173"

# Database
DATABASE_URL=storage/auth.sqlite3

# SMTP
SMTP_PORT=25
SMTP_HOST=localhost
SMTP_USER=smtp-user
SMTP_PASSWORD=smtp-password

# Goose
GOOSE_DRIVER=sqlite
GOOSE_DBSTRING=storage/auth.sqlite3
GOOSE_MIGRATION_DIR=migrations/auth

# Deployment
DEPLOYMENT_USER=deploy-user
DEPLOYMENT_SERVER=deploy-server

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET="some-secret-key"

